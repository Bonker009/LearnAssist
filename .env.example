# ---------- Postgres ----------
POSTGRES_DB=learnassist
POSTGRES_USER=learnassist
POSTGRES_PASSWORD=change-me-in-local-env
# 55432, not 5432: a native postgresql-x64-18 service already owns 5432 on this
# machine and wins over Docker's port mapping. Container-to-container traffic
# still uses 5432 inside the compose network.
POSTGRES_PORT=55432

# ---------- RustFS (S3-compatible object storage) ----------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=lecture-uploads
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Endpoint as seen from inside the compose network:
RUSTFS_ENDPOINT=http://rustfs:9000
# Endpoint as seen from the host/browser (presigned URLs must use this):
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- Ollama (runs natively on the HOST, not in compose) ----------
# From inside a container, the host is reachable as host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:32b-instruct
OLLAMA_EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ---------- Redis (answer and summary cache) ----------
# 6381 on the host: another project already publishes Redis on 6380 here.
REDIS_PORT=6381
REDIS_URL=redis://redis:6379/0
# Cached answers are keyed by document + question; a re-ingest bumps the
# document's cache generation, so stale answers cannot survive a re-index.
ANSWER_CACHE_TTL_SECONDS=86400

# ---------- Whisper (runs inside the ai container) ----------
# tiny | base | small | medium | large-v3. `small` is a reasonable accuracy/speed
# trade-off on CPU; use `medium` + float16 if the container has a GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# ---------- Services ----------
# 8081, not 8080: another project's container already publishes on 8080 here.
API_PORT=8081
AI_PORT=8000
WEB_PORT=3000
AI_BASE_URL=http://ai:8000
# Shared secret for Spring Boot -> FastAPI internal calls
INTERNAL_API_KEY=dev-internal-key-change-me

# ---------- Auth ----------
# Must be >= 32 bytes for HS256. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-with-openssl-rand-base64-48
JWT_EXPIRY_MINUTES=1440

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
